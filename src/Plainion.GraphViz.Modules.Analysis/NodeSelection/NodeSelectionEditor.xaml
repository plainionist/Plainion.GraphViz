<UserControl x:Class="Plainion.GraphViz.Modules.Analysis.NodeSelection.NodeSelectionEditor"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:pn="http://github.com/ronin4net/plainion"
             x:Name="_this">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Plainion.Prism;component/Resources/Templates.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="#FDFDF5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Pattern:" Padding="0,0,10,0"/>
            <TextBox Grid.Row="0" Grid.Column="1" ToolTip="Enter a case-insensitive regular expression"
                     Text="{Binding Pattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                     Validation.ErrorTemplate="{StaticResource HighlightErrorsWithBorder}">
                <i:Interaction.Behaviors>
                    <pn:TextBoxRaiseCommandOnEnterBehavior Command="{Binding SelectCommand}"/>
                </i:Interaction.Behaviors>
            </TextBox>
            <DockPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,5,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Select matches" Command="{Binding SelectCommand}"
                            ToolTip="Add matching nodes to the existing selection"/>
                    <Button Content="Deselect matches" Command="{Binding DeselectCommand}"
                            ToolTip="Remove matching nodes from the existing selection" Margin="5,0,0,0"/>
                </StackPanel>
                <CheckBox Content="Match on identifier" IsChecked="{Binding MatchOnIdentifier}"
                          VerticalAlignment="Center"/>
            </DockPanel>
        </Grid>

        <TextBlock Grid.Row="1" Text="{Binding ValidationError}" Foreground="Red"
                   TextWrapping="Wrap" Margin="5,0,5,5">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ValidationError}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <ListView Grid.Row="2" ItemsSource="{Binding PreviewNodes}"
                  SelectedItem="{Binding SelectedPreviewItem}" Margin="5,0,5,5">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding DisplayText}" Background="Transparent">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="MouseDown">
                                <prism:InvokeCommandAction Command="{Binding ElementName=_this, Path=DataContext.MouseDownCommand}"/>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </TextBlock>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
